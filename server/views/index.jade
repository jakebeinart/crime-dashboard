extends layout

block content
  div.dashboard-container
          
      div.filter-group
        label(for="district") Police District
        select#district
          option(value="") Any District
          option(value="1") District 1
          option(value="2") District 2
          option(value="3") District 3
          option(value="4") District 4
          option(value="5") District 5
          option(value="6") District 6
          
      div.filter-group
        label(for="fromDate") From Date
        input(type="date" id="fromDate" name="fromDate")
      
      div.filter-group
        label(for="toDate") To Date
        input(type="date" id="toDate" name="toDate")

      div.filter-group
        label(for="crimeType") Crime Category
        select#crimeType
          option(value="") All Categories
          option(value="VIOLENT") Violent Crimes
          option(value="PROPERTY") Property Crimes
          option(value="DOMESTIC") Domestic Crimes
          option(value="SEX CRIMES") Sex Crimes
          option(value="DRUGS") Drug Offenses
          option(value="WEAPONS") Weapon Offenses
          option(value="OTHER") Other
          
    div#map(style="height: 600px; width: 100%;")
    script(src='/javascripts/map.js')